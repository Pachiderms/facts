# Copier en .env (jamais commité). Toutes les variables sont préfixées FACTS_.
FACTS_ENV=dev
FACTS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# À mettre à true UNIQUEMENT derrière un reverse proxy de confiance (Render, Fly, ...)
FACTS_TRUST_PROXY_HEADERS=false

# Fournisseur LLM compatible API OpenAI (Groq, Gemini, Ollama...). Vérifier les quotas gratuits en vigueur.
FACTS_LLM_BASE_URL=https://api.groq.com/openai/v1
FACTS_LLM_API_KEY=
FACTS_LLM_MODEL=llama-3.3-70b-versatile
