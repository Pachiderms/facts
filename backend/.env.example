# Copier en .env (jamais commité). Toutes les variables sont préfixées FACTS_.
FACTS_ENV=dev
FACTS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# À mettre à true UNIQUEMENT derrière un reverse proxy de confiance (Render, Fly, ...)
FACTS_TRUST_PROXY_HEADERS=false

# Fournisseur LLM compatible API OpenAI (Groq, Gemini, Ollama...). Vérifier les quotas gratuits en vigueur.
FACTS_LLM_BASE_URL=https://api.groq.com/openai/v1
FACTS_LLM_API_KEY=
# llama-3.3-70b-versatile est retiré chez Groq (16/08/2026) : voir la liste à jour sur console.groq.com/docs/models
FACTS_LLM_MODEL=openai/gpt-oss-120b
# Modèles gpt-oss : réduit la réflexion (qui consomme des tokens). Laisser vide avec un autre modèle ou fournisseur.
FACTS_LLM_REASONING_EFFORT=low
# Modèle de secours (autre modèle = autre quota) si le principal répond 429 ou atteint le plafond global du jour.
# FACTS_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# FACTS_LLM_GLOBAL_DAILY_CALLS=900
# FACTS_ACCOUNT_DAILY_CHECK_LIMIT=60

# Recherche web : fournisseurs essayés dans l'ordre. Tavily est ignoré si la clé est vide.
FACTS_SEARCH_PROVIDERS=tavily,wikipedia,duckduckgo
FACTS_TAVILY_API_KEY=
# Offre gratuite : 1 000 crédits/mois ; on garde une marge (une vérification peut lancer 2 recherches).
FACTS_TAVILY_MONTHLY_LIMIT=900

# Plafonds par visiteur et par jour
FACTS_DAILY_CHECK_LIMIT=30
FACTS_DAILY_WS_MESSAGE_LIMIT=200

# Tri des messages par le LLM (repère les faits sans chiffre, écarte « selon moi… »). Un appel LLM par message.
# false = règle gratuite seule.
FACTS_CLAIM_TRIAGE=true

# Saisie vocale (Groq Whisper). Sans clé STT, réutilise FACTS_LLM_API_KEY. FACTS_STT_ENABLED=false pour couper.
FACTS_STT_ENABLED=true
FACTS_STT_DAILY_PER_PERSON=20
FACTS_STT_GLOBAL_DAILY_SECONDS=20000

# Base PostgreSQL (optionnelle ; vide = tout en mémoire). Neon : copier l'adresse « Pooled connection ».
# Migrations : `alembic upgrade head` (automatique au démarrage de l'image Docker).
FACTS_DATABASE_URL=

# Comptes (facultatifs) : identifiant client Google (public) + FACTS_DATABASE_URL. Vide = pas de comptes.
FACTS_GOOGLE_CLIENT_ID=

# Derrière Render : 1 proxy s'ajoute après l'adresse du visiteur (voir /health/ip). Sel des quotas : fixe en production.
# FACTS_PROXY_HOPS=1
# FACTS_QUOTA_SALT=
# Paiement Pro (Lemon Squeezy). Éteint par défaut ; l'activer exige les comptes et les deux valeurs ci-dessous.
# FACTS_PAYMENTS_ENABLED=false
# FACTS_LEMONSQUEEZY_WEBHOOK_SECRET=      # secret de signature du webhook (16 caractères minimum)
# FACTS_LEMONSQUEEZY_CHECKOUT_URL=        # https://<boutique>.lemonsqueezy.com/checkout/buy/<id>
# FACTS_PRO_PRICE_LABEL=                  # ex. « 5 € / mois »
# FACTS_PRO_DAILY_CHECK_LIMIT=250
# FACTS_PRO_DEBATE_DAILY_CHECKS=400
# FACTS_DEBATE_DAILY_CHECKS=40
# FACTS_ACCOUNT_DEBATE_DAILY_CHECKS=120
# FACTS_DEBATE_GLOBAL_DAILY_CHECKS=300
